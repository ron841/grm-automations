{
  "$schemaVersion": "1.0",
  "$schema": "composition-plan",
  "businessSlug": "greenridge-solar",
  "site": {
    "persona": "modern-specialist",
    "personaReason": "Solar installer trade-default is modern-specialist per emotional-arc.md trade mapping. Thin tenure signal (minimumEvidenced 2) and technical service vocabulary reinforce; no tenure-based override to neighborhood-steady available.",
    "tier": "Standard",
    "signatureMicroInteraction": "none",
    "signatureMicroInteractionReason": "Persona default is anchor-strip-pivot but requires >=5 page sections (Gate 2 tree rule 3). Standard tier + 3 services + thin content yields 4-section home page; tree rules 1/2/3/4/5 all fall through. Falls to 'none' per Gate 2 tree rule 6. Recorded as compound-weakness byproduct.",
    "microInteractions": ["underline-bloom"],
    "microInteractionsReason": "Modern-specialist Tier 2 default is [underline-bloom, mono-numeral-flip]. mono-numeral-flip suppressed — no statRow present. underline-bloom retained for technical body copy inline links. Budget ceiling 3; using 1.",
    "microInteractionDurations": { "entry": 400, "hover": 180 },
    "pathConvention": "kebab-case",
    "voicesInUse": ["kitchen-table", "closing-table"],
    "constraintsOK": false,
    "constraintRelaxations": [
      { "rule": "photoLibrary.accepted <= 4", "detail": "Site over-constraint threshold tripped at 4 accepted photos. Phase 4-new over-constraint rule: photoLibrary.accepted <= 4 trips site-level constraintsOK=false.", "severity": "warning" },
      { "rule": "servicesGrid photo-content-match", "detail": "Zero evidenceShot-eligible photos content-matched to 3 services. All 3 cards emit placeholderFlag: true. Fallback-path-b.", "severity": "warning" },
      { "rule": "brandPalette.vibrantPopulation low-confidence", "detail": "vibrantPopulation: 18 below typical confidence threshold. Palette derived from single-color tech logo.", "severity": "info" },
      { "rule": "reviewCount below threshold", "detail": "reviewCount: 6 below typical threshold; reviewCountCallout suppressed.", "severity": "info" },
      { "rule": "yearsInBusiness null", "detail": "yearsInBusiness: null with minimumEvidenced: 2. Tenure signals suppressed; statRow elided.", "severity": "info" }
    ],
    "colorScheme": {
      "primary": "#059669",
      "accent": "#0284C7",
      "darkPrimary": null,
      "primaryUsage": "accent-heavy"
    }
  },
